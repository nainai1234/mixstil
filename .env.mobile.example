# Public HTTPS origin for the production SNOOZE API and audio assets.
# Copy to .env.mobile for local native builds.
VITE_API_BASE_URL=https://api.example.com
# Store builds must use the real HTTPS API origin. Never ship localhost here.

# Shared App Store and Play Store version. Increment build number for every upload.
SNOOZE_VERSION=1.0.0
SNOOZE_BUILD_NUMBER=1

# Apple signing identity. Keep the real value in ignored .env.mobile only.
IOS_DEVELOPMENT_TEAM=

# Android upload key. Paths may be absolute or relative to the project root.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Public store-listing destinations. Submission validation rejects placeholders.
SNOOZE_SUPPORT_URL=https://support.example.com
SNOOZE_PRIVACY_URL=https://www.example.com/privacy
# Embedded in the public /support page. Use a monitored mailbox.
VITE_SUPPORT_EMAIL=support@example.com
