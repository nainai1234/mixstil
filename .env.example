DATABASE_URL=postgres://snooze:snooze@localhost:5432/snooze
GUIDED_VOICE_ENABLED=false
API_PORT=8788
NODE_ENV=development

# Production only. Use the deployed HTTPS web origin and Capacitor's native origin.
CORS_ALLOWED_ORIGINS=https://app.example.com,capacitor://localhost
TRUST_PROXY=1
# Production requires a unique value of at least 32 characters.
SHARE_CREATOR_PREVIEW_SECRET=
# Protects the production Prometheus-compatible metrics endpoint.
METRICS_BEARER_TOKEN=

# Local development keeps exports under public/exports. Production requires s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIRECTORY=public/exports
STORAGE_LOCAL_PUBLIC_PATH=/exports
STORAGE_BUCKET=
STORAGE_REGION=
# Optional for S3-compatible providers. AWS S3 does not need this value.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com/snooze-exports
EXPORT_MAX_OBJECT_BYTES=314572800
EXPORT_MAX_LOCAL_BYTES=10737418240
EXPORT_RETENTION_DAYS=30

# Vendor-neutral external monitoring boundary. Configure the deployment
# platform to scrape /internal/metrics and probe the health endpoints.
MONITORING_METRICS_URL=https://api.example.com/internal/metrics
MONITORING_LIVE_URL=https://api.example.com/api/health/live
MONITORING_READY_URL=https://api.example.com/api/health/ready

# Optional. Without a key, AI recipe intent classification uses the local rules fallback.
AI_RECIPE_PROVIDER=deepseek
AI_RECIPE_API_KEY=
AI_RECIPE_BASE_URL=https://api.deepseek.com
AI_RECIPE_MODEL=deepseek-v4-pro
AI_RECIPE_TIMEOUT_MS=15000
AI_RECIPE_MAX_TOKENS=1200
TTS_PROVIDER=edge-tts
TTS_COMMERCIAL_USE_CONFIRMED=false
# Required only for production TTS providers.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional: Google Vertex AI Lyria music generation.
# Production: absolute path to a private Service Account JSON key. Never expose
# this file to the browser, mobile app, source control, or public storage.
GOOGLE_APPLICATION_CREDENTIALS=/secure/secrets/sleepaudio-lyria-service-account.json
# Optional short-lived override for local diagnosis. If unset, the server uses
# GOOGLE_APPLICATION_CREDENTIALS / ADC first, then falls back to local gcloud.
GOOGLE_LYRIA_PROJECT_ID=project-a8dea3a9-cd9d-40dd-867
GOOGLE_LYRIA_LOCATION=global
GOOGLE_LYRIA_MODEL=lyria-3-clip-preview
GOOGLE_LYRIA_ENDPOINT=https://aiplatform.googleapis.com/v1beta1/projects/project-a8dea3a9-cd9d-40dd-867/locations/global/interactions
GOOGLE_CLOUD_ACCESS_TOKEN=
